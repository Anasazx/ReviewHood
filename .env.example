# Copy to .env and fill in real values:   cp .env.example .env
# Never commit .env.

# --- Image & domain ---
API_IMAGE=tunirate-api:prod
API_DOMAIN=api.tunirate.tn

# --- Postgres (used by both the db and api containers) ---
POSTGRES_DB=tunirate
POSTGRES_USER=tunirate
# generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# --- JWT (at least 32 characters) ---
# generate with: openssl rand -base64 48
JWT_SECRET=change-me

# --- Google sign-in ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- SMTP ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=change-me
